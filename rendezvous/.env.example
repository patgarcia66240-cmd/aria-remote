# Copie ce fichier en « .env » et remplis-le. Génère chaque secret avec :  openssl rand -hex 32

# Nom de domaine du serveur (son DNS doit pointer vers ce serveur), ex. rendezvous.mondomaine.fr
DOMAIN=

# Clé des AGENTS (à saisir dans la fenêtre de l'agent, sur chaque PC contrôlé).
RENDEZVOUS_AGENT_KEY=

# Clé du CONTRÔLEUR (à mettre dans backend/.env de PC Assistant : REMOTE_RENDEZVOUS_KEY). Différente de la clé des agents.
RENDEZVOUS_CONTROLLER_KEY=

# Secret partagé avec coturn : fabrique des identifiants de relais éphémères par session.
TURN_SECRET=

# Durée de validité d'un code d'appairage, en secondes (1800 = 30 minutes), et essais d'appairage par minute et par client.
PAIRING_CODE_TTL=1800
PAIR_RATE_LIMIT=10
