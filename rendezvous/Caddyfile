# HTTPS automatique (Let's Encrypt) pour DOMAIN : HTTP, WebSocket (wss://) compris. Le DNS de DOMAIN doit pointer vers ce serveur.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy rendezvous:8080 {
		# Remplace (ne complète pas) X-Forwarded-For : un client ne peut pas falsifier son IP pour contourner la limite d'essais.
		header_up X-Forwarded-For {remote_host}
	}
}
