{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARIA Remote",
  "mainBinaryName": "ARIA Remote",
  "version": "0.5.1",
  "identifier": "com.ariaremote.desktop",
  "build": {
    "frontendDist": "./web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "ARIA Remote", "width": 1100, "height": 720, "minWidth": 720, "minHeight": 480, "resizable": true, "useHttpsScheme": true }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self' https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
